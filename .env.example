# MCP connection URLs. These defaults target the local Data Center
# containers started with `docker compose --profile all up -d`.
# For integration-test runs see .env.dc.example.
JIRA_URL=http://localhost:8080
CONFLUENCE_URL=http://localhost:8090
BITBUCKET_URL=http://localhost:7990

# Product tokens take priority independently.
JIRA_TOKEN=
CONFLUENCE_TOKEN=
BITBUCKET_TOKEN=

# Shared fallback for every product that has no token.
ATLASSIAN_USERNAME=
ATLASSIAN_PASSWORD=

# TLS certificate and hostname verification is ON by default.
# Disable only for local testing against self-signed endpoints:
# ATLASSIAN_TLS_VERIFY=false
# (or start the server with --no-tls-verify)
# JIRA_CA_FILE=/absolute/path/to/company-ca.pem
# CONFLUENCE_CA_FILE=/absolute/path/to/company-ca.pem
# BITBUCKET_CA_FILE=/absolute/path/to/company-ca.pem

ATLASSIAN_MAX_OUTPUT_BYTES=65536
ATLASSIAN_CURSOR_TTL_SECONDS=900

# Optional Docker image/port overrides.
JIRA_VERSION=11.3.5
CONFLUENCE_VERSION=10.2.11
BITBUCKET_VERSION=10.4.1
JIRA_PORT=8080
CONFLUENCE_PORT=8090
BITBUCKET_PORT=7990
BITBUCKET_SSH_PORT=7999
