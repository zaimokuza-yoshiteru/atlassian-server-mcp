# Local real-product E2E environment. Run one product at a time.

JIRA_URL=http://localhost:8080
CONFLUENCE_URL=http://localhost:8090
BITBUCKET_URL=http://localhost:7990

# Personal access tokens created in each product UI (Profile -> Personal
# Access Tokens). Tokens take priority over the shared Basic credentials.
JIRA_TOKEN=
CONFLUENCE_TOKEN=
BITBUCKET_TOKEN=

# Shared Basic fallback used by the MCP server when a product token is empty.
# Use the admin account created during the setup wizard.
ATLASSIAN_USERNAME=
ATLASSIAN_PASSWORD=

# Admin credentials used for license refresh, fixture bootstrap, cleanup, and
# checking/creating the second reviewer user.
ATLASSIAN_ADMIN_USERNAME=
ATLASSIAN_ADMIN_PASSWORD=

# Local containers use plain HTTP; leave verification at its default (on).
# ATLASSIAN_TLS_VERIFY=false

# Optional second-user inputs. Prepare creates mcp-e2e-reviewer when absent and
# persists generated Basic credentials in gitignored .e2e-state/. PAT wins.
E2E_REVIEWER_USERNAME=mcp-e2e-reviewer
E2E_REVIEWER_EMAIL=mcp-e2e@163.com
# E2E_REVIEWER_PASSWORD=
# E2E_REVIEWER_JIRA_TOKEN=
# E2E_REVIEWER_CONFLUENCE_TOKEN=
# E2E_REVIEWER_BITBUCKET_TOKEN=

# Mailpit — local SMTP capture for E2E notification tests.
# Jira SMTP must be configured (once) via UI: Administration → Outgoing Mail →
# SMTP host=mailpit, port=1025, protocol=SMTP, no auth.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_HTTP_PORT=8025
# MAILPIT_API_URL=http://localhost:8025/api/v1

# File root for multipart uploads and binary downloads. The MCP server
# only reads/writes under this path. Required for avatar upload, attachment
# operations, patch exports, and any op using downloadPath.
# ATLASSIAN_FILE_ROOT=/tmp/atlassian-mcp-file-root

# Webhook sink sidecar — captures Bitbucket webhook deliveries during E2E.
# WEBHOOK_SINK_PORT=8026
# WEBHOOK_SINK_URL=http://localhost:8026

# Optional stable fixture container keys.
E2E_JIRA_PROJECT_KEY=MCP
E2E_CONFLUENCE_SPACE_KEY=MCP
